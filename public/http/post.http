@Host = http://127.0.0.1:9090
@AcceptLanguage = en
@Token = <access_token>
@PostId = <post_id>
@CommentId = <comment_id>

### Create post (visibility: public | followers | private)
post {{Host}}/post
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

{
    "content": "my first post",
    "visibility": "public",
    "commentsEnabled": true
}

### Get my posts (paginated)
get {{Host}}/post?page=1&size=10
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

### Get single post
get {{Host}}/post/{{PostId}}
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

### Update post (owner only, at least one field)
patch {{Host}}/post/{{PostId}}
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

{
    "content": "edited content"
}

### Delete post (owner only)
delete {{Host}}/post/{{PostId}}
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

### Create comment
post {{Host}}/post/{{PostId}}/comment
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

{
    "content": "nice post"
}

### Get post comments (paginated)
get {{Host}}/post/{{PostId}}/comment?page=1&size=10
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

### Get single comment
get {{Host}}/post/{{PostId}}/comment/{{CommentId}}
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

### Update comment (comment owner only)
patch {{Host}}/post/{{PostId}}/comment/{{CommentId}}
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}

{
    "content": "edited comment"
}

### Delete comment (comment owner or post owner)
delete {{Host}}/post/{{PostId}}/comment/{{CommentId}}
Accept-Language: {{AcceptLanguage}}
Authorization: Bearer {{Token}}
