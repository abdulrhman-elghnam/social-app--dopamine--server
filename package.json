{
  "name": "dopamine",
  "version": "1.0.0",
  "description": "Dopamine API \u2014 a social app for connecting people: posts, follows, comments, notifications and real-time chat.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./distribution/main.js",
  "scripts": {
    "build": "tsc",
    "start:dev": "concurrently -k \"tsc --watch\" \"cross-env NODE_ENV=development node --watch ./distribution/main.js\"",
    "start:prod-local": "npm run build && cross-env NODE_ENV=production node ./distribution/main.js",
    "start:prod": "npm run build && cross-env NODE_ENV=production pm2 start ./distribution/main.js -i max",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:config": "oxlint --init",
    "format": "npx prettier . --write",
    "start": "node ./distribution/main.js",
    "typecheck": "tsc --noEmit",
    "docs": "npm run build && node ./scripts/generate-docs.mjs"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "geoip-lite": "^2.0.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/swagger-ui-express": "^4.1.8",
    "globals": "^17.13.0",
    "morgan": "^1.12.1",
    "oxlint": "^1.89.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
